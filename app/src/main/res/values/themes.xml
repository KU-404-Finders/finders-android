<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KUfinders"
        parent="android:Theme.Material.Light.NoActionBar">

        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#1B6425</item>
    </style>

    <style name="Theme.KUfinders.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#FFFFFFFF</item>

        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher_round
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.KUfinders
        </item>

    </style>

</resources>